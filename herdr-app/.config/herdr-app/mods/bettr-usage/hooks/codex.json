{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.config/herdr-app/mods/bettr-usage/report_usage.py codex",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.config/herdr-app/mods/bettr-usage/report_usage.py codex",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
