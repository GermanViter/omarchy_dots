{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.config/herdr-app/mods/bettr-usage/report_usage.py claude",
            "async": true,
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.config/herdr-app/mods/bettr-usage/report_usage.py claude",
            "async": true,
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.config/herdr-app/mods/bettr-usage/report_usage.py claude",
            "async": true,
            "timeout": 20
          }
        ]
      }
    ]
  }
}
