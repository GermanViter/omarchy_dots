    for name, color in ansi(p).items():
        attrs[name] = attr(color)
    return colors, attrs


def build_scheme_xml(mode, p, source_xml, ide_version):
    v = VARIANTS[mode]
    root = ET.fromstring(source_xml)

    src_text = {}
    for opt in root.iterfind("./attributes/option[@name='TEXT']/value/option"):
        src_text[opt.get("name")] = "#" + opt.get("value").zfill(6)
    src_bg = src_text.get("BACKGROUND", "#ffffff" if mode == "light" else "#191a1c")
    src_fg = src_text.get("FOREGROUND", "#080808" if mode == "light" else "#bcbec4")
    remap = Remapper(p, src_bg, src_fg, mode)

    def hexval(value):
        return "#" + value.zfill(6) if value else ""

    colors = {}
    for opt in root.iterfind("./colors/option"):
        value = opt.get("value", "")
        if re.fullmatch(r"[0-9a-fA-F]{1,8}", value or ""):
            kind = "fg" if any(s in opt.get("name") for s in ("FILESTATUS", "LINES_COLOR", "BORDER_COLOR")) else "bg"
            colors[opt.get("name")] = remap(hexval(value), kind)
        else:
            colors[opt.get("name")] = value

    attrs, bases = {}, {}
    for opt in root.iterfind("./attributes/option"):
        name = opt.get("name")
        if opt.get("baseAttributes"):
            bases[name] = opt.get("baseAttributes")
            continue
        value = opt.find("value")
        if value is None:
            continue
        fields = {}
        for field in value.iterfind("option"):
            fname, fval = field.get("name"), field.get("value", "")
            if fname in ("FOREGROUND", "BACKGROUND", "EFFECT_COLOR", "ERROR_STRIPE_COLOR"):
                if re.fullmatch(r"[0-9a-fA-F]{1,8}", fval):
                    kind = "bg" if fname == "BACKGROUND" else "fg"
                    fields[fname] = remap(hexval(fval), kind)
                else:
                    fields[fname] = fval
            else:
                fields[fname] = fval
        attrs[name] = fields

    hand_colors, hand_attrs = scheme_values(mode, p)
    colors.update(hand_colors)
    for name, fields in hand_attrs.items():
        bases.pop(name, None)
        attrs[name] = fields

    scheme = ET.Element("scheme", name=v["name"], version="142", parent_scheme=v["parent_scheme"])
    meta = ET.SubElement(scheme, "metaInfo")
    for key, val in (("ide", "idea"), ("ideVersion", ide_version), ("originalScheme", v["name"])):
        ET.SubElement(meta, "property", name=key).text = val
    col_el = ET.SubElement(scheme, "colors")
    for name in sorted(colors):
        ET.SubElement(col_el, "option", name=name, value=colors[name].lstrip("#"))
    attr_el = ET.SubElement(scheme, "attributes")
    for name in sorted(set(attrs) | set(bases)):
        if name in bases:
            ET.SubElement(attr_el, "option", name=name, baseAttributes=bases[name])
            continue
        opt = ET.SubElement(attr_el, "option", name=name)
        val = ET.SubElement(opt, "value")
        for fname, fval in attrs[name].items():
            if fname in ("FOREGROUND", "BACKGROUND", "EFFECT_COLOR", "ERROR_STRIPE_COLOR"):
                fval = fval.lstrip("#")
            ET.SubElement(val, "option", name=fname, value=fval)
    ET.indent(scheme, "  ")
    return ET.tostring(scheme, encoding="unicode") + "\n"


# --- plugin ------------------------------------------------------------------

def find_ide():
    env = os.environ.get("INTELLIJ_HOME")
    candidates = [Path(env)] if env else []
    candidates += [Path("/usr/share/idea"), Path("/usr/share/intellij-idea-ultimate-edition")]
    for pattern in ("/opt/*idea*", "/opt/intellij*"):
        candidates += sorted(Path("/").glob(pattern.lstrip("/")))
    candidates += sorted((DATA_ROOT / "Toolbox/apps").glob("*idea*/**/product-info.json"))
    for c in candidates:
        c = c.parent if c.name == "product-info.json" else c
        if (c / PLATFORM_JAR).is_file():
            return c
    return None


def build_plugin(ide):
    info = json.loads((ide / "product-info.json").read_text()) if (ide / "product-info.json").exists() else {}
    ide_version = info.get("version", "")
    files = {}
    with zipfile.ZipFile(ide / PLATFORM_JAR) as jar:
        for mode, v in VARIANTS.items():
            palette = load_palette(v["slug"])
            islands = json.loads(jar.read(v["islands_json"]))
            theme = build_theme_json(mode, palette, islands)
            scheme = build_scheme_xml(mode, palette, jar.read(v["source_scheme"]), ide_version)
            files[f"themes/{v['slug']}.theme.json"] = json.dumps(theme, indent=2) + "\n"
            files[f"themes/{v['slug']}.xml"] = scheme

    digest = hashlib.sha256("".join(files[k] for k in sorted(files)).encode()).hexdigest()[:10]
    providers = "\n".join(
        f'    <themeProvider id="{v["slug"]}" path="/themes/{v["slug"]}.theme.json" targetUi="islands"/>'
        for v in VARIANTS.values()
    )
    files["META-INF/plugin.xml"] = f"""<idea-plugin>
  <id>{PLUGIN_ID}</id>
  <name>Shoujo Theme</name>
  <version>1.0.0+{digest}</version>
  <vendor>Omarchy dotfiles</vendor>
  <description><![CDATA[
    Shoujo Dark and Shoujo Light, the Omarchy Shoujo themes for the Islands UI.
    Generated by intellij-shoujo-theme from the themes' colors.toml.
  ]]></description>
  <idea-version since-build="253"/>
  <depends>com.intellij.modules.platform</depends>
  <extensions defaultExtensionNs="com.intellij">
{providers}
  </extensions>
</idea-plugin>
"""
    buf = io.BytesIO()
    with zipfile.ZipFile(buf, "w", zipfile.ZIP_DEFLATED) as out:
        for name in sorted(files):
            entry = zipfile.ZipInfo(name, date_time=(1980, 1, 1, 0, 0, 0))
            entry.compress_type = zipfile.ZIP_DEFLATED
            out.writestr(entry, files[name])
    return buf.getvalue(), files


def product_dirs():
    if not CONFIG_ROOT.is_dir():
        return []
    return sorted(d.name for d in CONFIG_ROOT.iterdir()
                  if d.is_dir() and re.fullmatch(r"[A-Za-z]+\d{4}\.\d+", d.name))


def install(jar_bytes, product):
    target = DATA_ROOT / product / PLUGIN_DIR / "lib" / f"{PLUGIN_DIR}.jar"
    if target.is_file() and target.read_bytes() == jar_bytes:
        return target, False
    target.parent.mkdir(parents=True, exist_ok=True)
    tmp = target.with_suffix(".jar.tmp")
    tmp.write_bytes(jar_bytes)
    tmp.replace(target)
    return target, True


# --- IDE settings ------------------------------------------------------------

def ide_running():
    result = subprocess.run(["pgrep", "-f", "com.intellij.idea.Main"], capture_output=True)
    return result.returncode == 0


def backup(path):
    if path.exists():
        stamp = datetime.now().strftime("%Y%m%d%H%M%S")
        path.with_name(f"{path.name}.bak.{stamp}").write_bytes(path.read_bytes())


def load_application_xml(path):
    if path.exists():
        return ET.parse(path).getroot()
    return ET.Element("application")


def component(root, name):
    comp = root.find(f"./component[@name='{name}']")
    if comp is None:
        comp = ET.SubElement(root, "component", name=name)
    return comp


def set_child(parent, tag, **attrs):
    el = parent.find(tag)
    if el is None:
        el = ET.SubElement(parent, tag)
    el.attrib.clear()
    el.attrib.update(attrs)


def write_xml(root, path):
    ET.indent(root, "  ")
    path.write_text(ET.tostring(root, encoding="unicode") + "\n")


def configure(product):
    options = CONFIG_ROOT / product / "options"
    options.mkdir(parents=True, exist_ok=True)
    current = CURRENT_THEME_NAME.read_text().strip() if CURRENT_THEME_NAME.exists() else ""
    mode = "light" if current == VARIANTS["light"]["slug"] else "dark"

    laf_path = options / "laf.xml"
    backup(laf_path)
    root = load_application_xml(laf_path)
    laf = component(root, "LafManager")
    laf.set("autodetect", "true")
    set_child(laf, "laf", themeId=VARIANTS[mode]["slug"])
    set_child(laf, "preferred-light-laf", themeId=VARIANTS["light"]["slug"])
    set_child(laf, "preferred-dark-laf", themeId=VARIANTS["dark"]["slug"])
    write_xml(root, laf_path)

    scheme_path = options / "colors.scheme.xml"
    backup(scheme_path)
    root = load_application_xml(scheme_path)
    set_child(component(root, "EditorColorsManagerImpl"), "global_color_scheme", name=VARIANTS[mode]["name"])
    write_xml(root, scheme_path)
    return laf_path, scheme_path


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--configure", action="store_true",
                        help="set Sync with OS to Shoujo Light/Dark (IDE must be closed)")
    parser.add_argument("--quiet", action="store_true")
    parser.add_argument("theme", nargs="?", help=argparse.SUPPRESS)  # slug passed by the theme-set hook
    args = parser.parse_args()
    say = (lambda *a: None) if args.quiet else print

    for v in VARIANTS.values():
        if not (THEMES_DIR / v["slug"] / "colors.toml").is_file():
            say(f"No {v['slug']} theme in {THEMES_DIR}; nothing to build.")
            return 0
    ide = find_ide()
    if ide is None:
        say("No IntelliJ IDEA install found (set INTELLIJ_HOME); nothing to build.")
        return 0
    products = product_dirs()
    if not products:
        say(f"No JetBrains config dirs in {CONFIG_ROOT}; start the IDE once first.")
        return 0

    jar_bytes, _ = build_plugin(ide)
    for product in products:
        target, changed = install(jar_bytes, product)
        say(f"{'Installed' if changed else 'Up to date'}: {target}")

    if args.configure:
        if ide_running():
            say("IntelliJ is running; close it and run with --configure again.")
            return 1
        for product in products:
            for path in configure(product):
                say(f"Configured: {path}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
